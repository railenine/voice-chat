# ==============================================================================
# RVxis Server Configuration Template (.env.example)
# Copy to .env and fill in required secrets for production deployment.
# NEVER commit the actual .env file or real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment & Network
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Trusted CORS origins (comma-separated). In production, set to your exact domain(s).
# Desktop Tauri apps use tauri://localhost or http://tauri.localhost
CORS_ORIGIN=https://rvxis.site,tauri://localhost,http://tauri.localhost,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Coturn STUN/TURN Server Configuration (VPS WebRTC NAT traversal)
# ------------------------------------------------------------------------------
# Domain and ports for Coturn service
COTURN_DOMAIN=rvxis.site
COTURN_PORT=3478
COTURN_TLS_PORT=5349

# TURN Authentication credentials
COTURN_USER=voicechat

# REQUIRED IN PRODUCTION: Strong TURN password (generate e.g. with `openssl rand -hex 32`)
# If not set in production, server will refuse to start for security.
COTURN_PASSWORD=<YOUR_COTURN_LONG_SECURE_PASSWORD>

# OPTIONAL: Shared secret for Ephemeral (time-limited) TURN credentials (RFC 5766 REST API)
# If provided, the server generates short-lived HMAC credentials instead of static password.
# COTURN_SHARED_SECRET=<YOUR_COTURN_SHARED_SECRET_FOR_TIME_LIMITED_TOKENS>

# ------------------------------------------------------------------------------
# 3. LiveKit SFU Configuration (Screen Sharing Video Engine)
# ------------------------------------------------------------------------------
# URL of LiveKit SFU instance
LIVEKIT_URL=https://livekit.rvxis.site

# REQUIRED IF SCREEN SHARING ENABLED:
# LiveKit API Key and Secret (minimum 32 characters recommended)
LIVEKIT_API_KEY=<YOUR_LIVEKIT_API_KEY>
LIVEKIT_API_SECRET=<YOUR_LIVEKIT_API_SECRET_MIN_32_CHARS>

# ------------------------------------------------------------------------------
# 4. API Protection & Rate Limiting
# ------------------------------------------------------------------------------
# Maximum token generation requests per IP per minute (default: 20)
RATE_LIMIT_TOKEN_PER_MINUTE=20

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceChat",
  "version": "0.0.41",
  "identifier": "com.railenine.voicechat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFM0IwQ0IzOEUwMEE1RDAKUldUUXBRQ09zd3c3SHJvc3NwemdBdUZndlFpZ3lBbWdpWDhQdHJJZW0yU1FvUkhibFpIRUNhaXQK",
      "endpoints": [
        "https://rvxis.site/api/updater/latest.json",
        "https://github.com/railenine/voice-chat/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoiceChat",
        "width": 1024,
        "height": 768,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#020617"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
